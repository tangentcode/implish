#!/usr/bin/env bash
# bin/deploy: build web/ and publish dist-web/ to the implish.org docroot.
#
#   bin/deploy [--dry-run] [--skip-build]   build, back up live docroot, rsync
#   bin/deploy --rollback [NAME] [--dry-run] restore newest (or NAME) backup
#   bin/deploy --list-backups               list backups, oldest first
#
# Configuration comes from deploy/deploy.conf, overridden by environment:
#   DEPLOY_HOST        ssh host, or "local" to treat DEPLOY_PATH as a local path
#   DEPLOY_USER        ssh user (optional; empty = ssh default / ~/.ssh/config)
#   DEPLOY_PATH        absolute path of the live docroot
#   DEPLOY_BACKUP_DIR  where timestamped backups live (default: DEPLOY_PATH.backups)
#   DEPLOY_KEEP        how many backups to keep (default 5)
#   DEPLOY_SSH         ssh command (default: ssh -o BatchMode=yes)
#   DEPLOY_BUILD_CMD   build command (default: npx vite build)
#   DEPLOY_LOCK_WAIT   seconds to wait for another deploy's lock (default 60)
#   DEPLOY_SRC         build output to publish (default: dist-web)
#
# Exits nonzero on any failure. Nothing on the target is touched until the
# build has succeeded and produced an index.html.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
CONF=${DEPLOY_CONF:-$ROOT/deploy/deploy.conf}

die() { echo "deploy: $*" >&2; exit 1; }
log() { echo "deploy: $*" >&2; }

# Non-empty environment values win over the config file. Empty ones are
# ignored, because CI maps unset repository variables to empty strings.
declare -A from_env=()
for v in DEPLOY_HOST DEPLOY_USER DEPLOY_PATH DEPLOY_BACKUP_DIR DEPLOY_KEEP \
         DEPLOY_SSH DEPLOY_BUILD_CMD DEPLOY_SRC DEPLOY_LOCK_WAIT; do
  [[ -n ${!v:-} ]] && from_env[$v]=${!v}
done
if [[ -f $CONF ]]; then
  # shellcheck source=/dev/null
  source "$CONF"
fi
for v in "${!from_env[@]}"; do printf -v "$v" '%s' "${from_env[$v]}"; done

DEPLOY_HOST=${DEPLOY_HOST:-}
DEPLOY_USER=${DEPLOY_USER:-}
DEPLOY_PATH=${DEPLOY_PATH:-}
DEPLOY_KEEP=${DEPLOY_KEEP:-5}
DEPLOY_SSH=${DEPLOY_SSH:-ssh -o BatchMode=yes}
DEPLOY_BUILD_CMD=${DEPLOY_BUILD_CMD:-npx vite build}
DEPLOY_SRC=${DEPLOY_SRC:-dist-web}

mode=deploy dry_run=0 skip_build=0 rollback_name=
while (($#)); do
  case $1 in
    --dry-run|-n) dry_run=1 ;;
    --skip-build) skip_build=1 ;;
    --rollback)
      mode=rollback
      if [[ ${2:-} && ${2:0:1} != - ]]; then rollback_name=$2; shift; fi ;;
    --list-backups) mode=list ;;
    -h|--help) sed -n '2,/^set -e/{/^set -e/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

# --- validate config before doing anything -------------------------------
[[ -n $DEPLOY_HOST ]] || die "DEPLOY_HOST is not set (see deploy/deploy.conf)"
[[ -n $DEPLOY_PATH ]] || die "DEPLOY_PATH is not set (see deploy/deploy.conf)"
DEPLOY_PATH=${DEPLOY_PATH%/}
DEPLOY_BACKUP_DIR=${DEPLOY_BACKUP_DIR:-$DEPLOY_PATH.backups}
DEPLOY_BACKUP_DIR=${DEPLOY_BACKUP_DIR%/}
check_path() { # name value: refuse paths that rsync --delete could wreck
  local name=$1 p=$2
  [[ $p == /* ]] || die "$name must be absolute: '$p'"
  [[ $p =~ ^/+[^/]+/+[^/]+ ]] || die "$name is too shallow to be safe: '$p'"
  [[ /$p/ != */../* && /$p/ != */./* ]] || die "$name must not contain . or .. : '$p'"
  [[ $p != *[[:space:]\'\"\\]* ]] || die "$name must not contain spaces or quotes: '$p'"
}
check_path DEPLOY_PATH "$DEPLOY_PATH"
check_path DEPLOY_BACKUP_DIR "$DEPLOY_BACKUP_DIR"
[[ $DEPLOY_BACKUP_DIR != "$DEPLOY_PATH" && $DEPLOY_BACKUP_DIR/ != "$DEPLOY_PATH"/* ]] \
  || die "DEPLOY_BACKUP_DIR must not be inside DEPLOY_PATH (rsync --delete would remove it)"
[[ $DEPLOY_KEEP =~ ^[1-9][0-9]*$ ]] || die "DEPLOY_KEEP must be a positive integer: '$DEPLOY_KEEP'"
DEPLOY_LOCK_WAIT=${DEPLOY_LOCK_WAIT:-60}
[[ $DEPLOY_LOCK_WAIT =~ ^[0-9]+$ ]] || die "DEPLOY_LOCK_WAIT must be a whole number of seconds: '$DEPLOY_LOCK_WAIT'"

if [[ $DEPLOY_HOST == local ]]; then
  target=$DEPLOY_PATH
else
  target=${DEPLOY_USER:+$DEPLOY_USER@}$DEPLOY_HOST:$DEPLOY_PATH
fi

# on_target SCRIPT ARGS...: run a bash snippet where the docroot lives.
on_target() {
  local script=$1; shift
  if [[ $DEPLOY_HOST == local ]]; then
    bash -c "$script" on_target "$@"
  else
    local q; q=$(printf ' %q' "$@")
    # shellcheck disable=SC2086
    $DEPLOY_SSH "${DEPLOY_USER:+$DEPLOY_USER@}$DEPLOY_HOST" "bash -s --$q" <<<"$script"
  fi
}

# rsync options shared by deploy and rollback. --checksum so CI checkouts
# (fresh mtimes) only list files whose content changed. /.well-known/ is
# protected from --delete because certbot keeps its challenges there.
RSYNC_OPTS=(-rlp --checksum --delete --delay-updates --itemize-changes
            --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r --filter='P /.well-known/')
rsync_to() { # SRC DEST [extra rsync args...]
  local src=$1 dest=$2; shift 2
  if [[ $DEPLOY_HOST == local ]]; then
    rsync "${RSYNC_OPTS[@]}" "$@" "$src" "$dest"
  else
    rsync "${RSYNC_OPTS[@]}" -e "$DEPLOY_SSH" "$@" "$src" "$dest"
  fi
}

# The target-side half lives in deploy/remote.sh and is piped to bash.
REMOTE_LIB=$(<"$ROOT/deploy/remote.sh")
remote() { on_target "$REMOTE_LIB" "$DEPLOY_PATH" "$DEPLOY_BACKUP_DIR" "$DEPLOY_KEEP" "$@"; }

# hold_lock: take $DEPLOY_BACKUP_DIR/.lock on the target and keep it until
# this script exits, so a manual --rollback can't interleave with a CI deploy.
# A coprocess keeps an ssh session (or a local bash) open, which runs flock
# and then waits on stdin. When we exit, or the connection drops, its stdin
# closes and the lock is released. The script is passed as a bash -c string
# because stdin is the keepalive pipe. It must not contain single quotes.
# shellcheck disable=SC2016
LOCK_SCRIPT='mkdir -p "$1" && exec 9>>"$1/.lock" && flock -w "$2" 9 && echo locked && exec cat >/dev/null'
hold_lock() {
  local q; q=$(printf ' %q' "$DEPLOY_BACKUP_DIR" "$DEPLOY_LOCK_WAIT")
  if [[ $DEPLOY_HOST == local ]]; then
    coproc LOCK { bash -c "$LOCK_SCRIPT" hold_lock "$DEPLOY_BACKUP_DIR" "$DEPLOY_LOCK_WAIT"; }
  else
    # shellcheck disable=SC2086
    coproc LOCK { $DEPLOY_SSH "${DEPLOY_USER:+$DEPLOY_USER@}$DEPLOY_HOST" "bash -c '$LOCK_SCRIPT' hold_lock$q"; }
  fi
  local line=
  read -r line <&"${LOCK[0]}" || true
  [[ $line == locked ]] || die "could not take $DEPLOY_BACKUP_DIR/.lock (another deploy or rollback running?); nothing changed"
  log "holding $DEPLOY_BACKUP_DIR/.lock"
}

case $mode in
  list) remote list; exit 0 ;;

  rollback)
    ((dry_run)) || hold_lock
    name=$(remote pick "$rollback_name")
    log "rolling back $target to backup $name"
    if ((dry_run)); then
      remote restore "$name" dry
      log "dry run: nothing changed"
      exit 0
    fi
    remote restore "$name"
    # The restored tree is now live, so the backup is redundant. Dropping it
    # makes a second --rollback step one deploy further back.
    if [[ -z $rollback_name ]]; then remote drop "$name"; fi
    log "rolled back to $name"
    exit 0 ;;
esac

# --- deploy ---------------------------------------------------------------
cd "$ROOT"
if ((skip_build)); then
  log "skipping build (--skip-build)"
else
  log "building: $DEPLOY_BUILD_CMD"
  bash -c "$DEPLOY_BUILD_CMD" || die "build failed; nothing was deployed"
fi
[[ -f $DEPLOY_SRC/index.html ]] || die "$DEPLOY_SRC/index.html missing after build; nothing was deployed"

if ((dry_run)); then
  log "dry run: changes that would be made to $target"
  if [[ $(remote exists) == no ]]; then
    log "(docroot does not exist yet; every file would be new)"
    (cd "$DEPLOY_SRC" && find . -type f -printf '>f+++++++++ %P\n' | LC_ALL=C sort)
  else
    rsync_to "$DEPLOY_SRC/" "$target/" --dry-run
  fi
  log "dry run: nothing changed"
  exit 0
fi

hold_lock
remote backup
remote mkroot
rsync_to "$DEPLOY_SRC/" "$target/"
remote prune
log "deployed $(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?') to $target"
